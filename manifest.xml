<?xml version="1.0" encoding="UTF-8"?>
<!-- Sustituye marconav-ucm por tu nombre de usuario de GitHub en todas las URL (5 veces). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>c199d4d8-9291-4c53-8f46-b14fa9c0996a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Marcos J. Navarro-Santana</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Visor HTML interactivo"/>
  <Description DefaultValue="Muestra un HTML interactivo (por ejemplo, un artefacto de Claude) dentro de la diapositiva, también en modo presentación."/>
  <IconUrl DefaultValue="https://marconav-ucm.github.io/visor-html-ppt/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://marconav-ucm.github.io/visor-html-ppt/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://marconav-ucm.github.io/visor-html-ppt/"/>
  <AppDomains>
    <AppDomain>https://marconav-ucm.github.io</AppDomain>
    <AppDomain>https://claude.ai</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://marconav-ucm.github.io/visor-html-ppt/index.html"/>
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
